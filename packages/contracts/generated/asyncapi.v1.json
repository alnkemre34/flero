            "type": "string",
            "pattern": "^cnv_[a-z2-7]{26}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "message_id": {
            "type": "string",
            "pattern": "^msg_[a-z2-7]{26}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "TEXT",
              "PHOTO",
              "GOLD_GIFT",
              "SYSTEM"
            ]
          },
          "body": {
